// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MODELOS MULTI-TENANT (SaaS)
// ==========================================

model Tenant {
  id               String   @id @default(uuid())
  name             String
  domain           String?  @unique
  subscriptionPlan String   @default("BASIC")
  isActive         Boolean  @default(true)
  mandatoryDocs    String?  // JSON string
  documents        String?  // JSON string
  saasClientId     String?  // Referencia al Cliente SaaS (Frontend Store.clients)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  users            User[]
  roles            Role[]

  @@index([saasClientId])
  @@index([isActive])
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String
  isActive     Boolean  @default(true)
  profileData  String?  // JSON string
  saasClientId String?  // Referencia al Cliente SaaS (Frontend Store.clients)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  userRoles    UserRole[]
  attendanceLogs AttendanceLog[]

  @@unique([tenantId, email]) // Un usuario es único por empresa
  @@index([saasClientId])
  @@index([tenantId])
  @@index([isActive])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String?  // Si es null, es un rol global del sistema
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name]) // El nombre del rol no se puede repetir en una misma empresa
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // ej: 'users:read', 'reports:write'
  description String?
  
  // Relaciones
  rolePermissions RolePermission[]
}

// ==========================================
// TABLAS INTERMEDIAS (RELACIONES MUCHOS-A-MUCHOS)
// ==========================================

model UserRole {
  userId String
  roleId String

  // Relaciones
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId]) // Llave primaria compuesta
}

model RolePermission {
  roleId       String
  permissionId String

  // Relaciones
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId]) // Llave primaria compuesta
}

// ==========================================
// REGISTRO DE ASISTENCIAS (LOGS)
// ==========================================

model AttendanceLog {
  id        String   @id @default(uuid())
  userId    String   // Trabajador que escaneó el QR
  type      String   // 'IN' para entrada, 'OUT' para salida
  timestamp DateTime @default(now())

  // Relaciones
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
}
// ==========================================
// USUARIOS DE LA PLATAFORMA (SaaS Admins/Clients)
// ==========================================
model PlatformUser {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   // 'Diamante', 'Platino', 'Oro', etc.
  clientId  String?  // null para Diamante, ID del cliente para los dems
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([role])
}

// ==========================================
// ALMACENAMIENTO CENTRALIZADO DE ARCHIVOS Y DOCUMENTOS (ETAPA 2)
// ==========================================
model StoredFile {
  id           String   @id @default(uuid())
  saasClientId String?  // Cliente SaaS propietario
  companyId    String?  // ID de la empresa (Tenant.id) asociada
  workerId     String?  // ID del trabajador (User.id) asociado
  category     String   @default("COMPANY_DOC") // 'COMPANY_DOC', 'COMPANY_HISTORY_DOC', 'WORKER_DOC', 'WORKER_PHOTO'
  docIndex     Int?     // Índice del documento requerido (0..10 empresa, 0..7 trabajador)
  fileName     String   // Nombre original del archivo
  mimeType     String   // 'application/pdf', 'image/jpeg', 'image/png', 'image/webp'
  sizeBytes    Int      @default(0)
  uploadedBy   String?  // Usuario que cargó el archivo
  externalUrl  String?  // URL externa opcional si se almacena en S3/Hostinger
  contentData  String   // Contenido binario en DataURL/Base64 (solo se consulta en GET /api/files/:id)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([saasClientId])
  @@index([companyId])
  @@index([workerId])
}

// ==========================================
// BITÁCORA DE AUDITORÍA Y MONITOREO (ETAPA 4)
// ==========================================
model AuditLog {
  id           String   @id @default(uuid())
  username     String   // Usuario que ejecutó la acción
  role         String   // Rol del usuario ('Diamante', 'Platino', etc.)
  saasClientId String?  // Cliente SaaS relacionado
  action       String   // 'LOGIN_SUCCESS', 'LOGIN_FAILED', 'COMPANY_CREATE', 'WORKER_UPDATE', 'SANCTION_UPDATE', etc.
  entityType   String   // 'AUTH', 'USER', 'COMPANY', 'WORKER', 'DOCUMENT', 'BACKUP', 'SYSTEM'
  entityId     String?  // ID del registro afectado
  details      String?  // Resumen legible o JSON con detalles del cambio
  ipAddress    String?  // Dirección IP de origen
  createdAt    DateTime @default(now())

  @@index([saasClientId, createdAt(sort: Desc)])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}

// ==========================================
// RESPALDOS AUTOMÁTICOS Y PUNTOS DE RESTAURACIÓN (ETAPA 4)
// ==========================================
model SystemBackupSnapshot {
  id           String   @id @default(uuid())
  saasClientId String?  // null = respaldo global de toda la plataforma
  triggerType  String   @default("AUTO_DAILY") // 'AUTO_DAILY' | 'MANUAL'
  createdBy    String   @default("Sistema")
  statsJson    String   // Resumen JSON de conteos (empresas, trabajadores, asistencias, archivos)
  snapshotData String   // JSON serializado con la instantánea de configuración, empresas y trabajadores
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}


